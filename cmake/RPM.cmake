if(NOT CMAKE_INSTALL_PREFIX STREQUAL "/usr")
    message(FATAL_ERROR "RPM generation requires -DCMAKE_INSTALL_PREFIX=/usr.")
endif()
set(CQ_RPM_RELEASE 1 CACHE STRING "Plugin RPM packaging revision")
if(NOT CQ_RPM_RELEASE MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "CQ_RPM_RELEASE must be a positive integer.")
endif()

set(CPACK_GENERATOR RPM)
set(CPACK_SOURCE_GENERATOR "")
set(CPACK_PACKAGE_NAME konsole-command-queue)
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}+konsole${KONSOLE_VERSION}")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Per-session command queues for Konsole")
set(CPACK_RPM_PACKAGE_DESCRIPTION "Queue shell commands per terminal session in an on-demand Konsole panel. Includes optional Bash and Zsh integration scripts; shell activation remains explicit.")
set(CPACK_PACKAGE_VENDOR "Command Queue")
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
set(CPACK_PACKAGE_DIRECTORY "${CMAKE_BINARY_DIR}/packages")
file(MAKE_DIRECTORY "${CPACK_PACKAGE_DIRECTORY}/tmp")
set(CPACK_RPM_SPEC_MORE_DEFINE "%define _tmppath ${CPACK_PACKAGE_DIRECTORY}/tmp")
set(CPACK_PACKAGING_INSTALL_PREFIX /usr)
set(CPACK_RPM_FILE_NAME RPM-DEFAULT)
set(CPACK_RPM_PACKAGE_LICENSE MIT)
set(CPACK_RPM_PACKAGE_ARCHITECTURE "${installed_konsole_ARCH}")
# The plugin's packaging revision is independent of Konsole's RPM release.
set(CPACK_RPM_PACKAGE_RELEASE "${CQ_RPM_RELEASE}")
set(CPACK_RPM_PACKAGE_RELEASE_DIST ON)

# Konsole ignores the plugin when the metadata from the plugin mentions another konsole version.
# We can safely comment the next line to make sure that the custom plugin does not hold back
# konsole version. This also implies the plugin will silenty stops working after each konsole update.
#set(CPACK_RPM_PACKAGE_REQUIRES "${installed_konsole_DEPENDENCY}")

set(CPACK_RPM_USER_FILELIST "%license /usr/share/licenses/konsole-command-queue/LICENSE")
# Shared-library requirements are generated by RPM in addition to the upstream-version pin.
set(CPACK_RPM_PACKAGE_AUTOREQPROV ON)
configure_file("${CMAKE_CURRENT_LIST_DIR}/RPMCheck.cmake.in" "${CMAKE_BINARY_DIR}/RPMCheck.cmake" @ONLY)
set(CPACK_PROJECT_CONFIG_FILE "${CMAKE_BINARY_DIR}/RPMCheck.cmake")
message(STATUS "RPM requires: ${CPACK_RPM_PACKAGE_REQUIRES}")
include(CPack)
