# Support Fedora's current configure-then-build recipe. Reject new recipe
# shapes instead of accidentally executing compilation during configuration.
function(cq_validate_konsole_spec spec)
    file(READ "${spec}" contents)
    if(contents MATCHES "\n%(conf|generate_buildrequires)([ \t]|\n)")
        message(FATAL_ERROR "Konsole spec has a separate configure/dynamic-build stage; review its header-only preparation before using it.")
    endif()
    string(FIND "${contents}" "\n%prep\n" prep_start)
    string(FIND "${contents}" "\n%build\n" start)
    if(prep_start LESS 0 OR start LESS prep_start)
        message(FATAL_ERROR "Unsupported Konsole spec preparation layout.")
    endif()
    math(EXPR prep_start "${prep_start} + 7")
    math(EXPR prep_length "${start} - ${prep_start}")
    string(SUBSTRING "${contents}" ${prep_start} ${prep_length} prep)
    string(REGEX REPLACE "(^|\n)[ \t]*#[^\n]*" "" prep "${prep}")
    string(STRIP "${prep}" prep)
    if(NOT prep STREQUAL "%autosetup -p1")
        message(FATAL_ERROR "Unsupported Konsole %prep recipe. Expected %autosetup -p1; review source preparation before using it.")
    endif()
    string(FIND "${contents}" "\n%install\n" end)
    if(start LESS 0 OR end LESS start)
        message(FATAL_ERROR "Unsupported Konsole spec build layout.")
    endif()
    math(EXPR start "${start} + 8")
    math(EXPR length "${end} - ${start}")
    string(SUBSTRING "${contents}" ${start} ${length} body)
    string(REGEX REPLACE "\\\\\n" " " body "${body}")
    string(REGEX REPLACE "(^|\n)[ \t]*#[^\n]*" "" body "${body}")
    string(STRIP "${body}" body)
    if(NOT body MATCHES "^%cmake_kf6([ \t][^\n]*)?\n[ \t\n]*%cmake_build$"
        OR body MATCHES "[;&|`]")
        message(FATAL_ERROR "Unsupported Konsole %build recipe. Expected only %cmake_kf6 followed by %cmake_build; refusing to run possible compilation.")
    endif()
endfunction()
