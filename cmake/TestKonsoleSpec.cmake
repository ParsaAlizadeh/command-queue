include("${CMAKE_CURRENT_LIST_DIR}/ValidateKonsoleSpec.cmake")
if(DEFINED CHECK_SPEC)
    cq_validate_konsole_spec("${CHECK_SPEC}")
    return()
endif()
file(MAKE_DIRECTORY "${TEST_BINARY_DIR}")
set(valid "Name: konsole\n%prep\n%autosetup -p1\n%build\n%cmake_kf6 \\\n  -DBUILD_TESTING:BOOL=ON\n\n%cmake_build\n%install\n%cmake_install\n")
set(no_flags "${valid}")
string(REPLACE "%cmake_kf6 \\\n  -DBUILD_TESTING:BOOL=ON" "%cmake_kf6" no_flags "${no_flags}")
string(REPLACE "%cmake_build" "%cmake_build\nmake" extra_build "${valid}")
string(REPLACE "%cmake_build" "ninja" direct_build "${valid}")
string(REPLACE "%autosetup -p1" "%autosetup -p1\nmake" prep_build "${valid}")
string(REPLACE "%build" "%conf\nmake\n%build" separate_conf "${valid}")
foreach(case valid no_flags extra_build direct_build prep_build separate_conf)
    set(spec "${TEST_BINARY_DIR}/${case}.spec")
    file(WRITE "${spec}" "${${case}}")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DCHECK_SPEC=${spec}" -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(case STREQUAL "valid" OR case STREQUAL "no_flags")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Valid recipe rejected: ${case}: ${error}")
        endif()
    elseif(result EQUAL 0 OR NOT error MATCHES "(Unsupported Konsole|separate configure)")
        message(FATAL_ERROR "Compilation recipe was not rejected: ${case}: ${error}")
    endif()
endforeach()
